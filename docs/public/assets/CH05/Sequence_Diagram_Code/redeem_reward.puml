@startuml
skinparam backgroundColor #FAFAFA
skinparam sequence {
  ArrowColor #2F5D8A
  LifeLineBorderColor #2F5D8A
  LifeLineBackgroundColor #D9E8F5
  ParticipantBorderColor #1B3C59
  ParticipantBackgroundColor #E6EEF5
  ActorBorderColor #3D3D3D
  ActorBackgroundColor #F2F2F2
  GroupBackgroundColor #F7F0D3
  GroupBorderColor #C5AF59
}
skinparam dpi 300
skinparam maxMessageSize 240
skinparam ParticipantPadding 30
skinparam sequenceParticipantWidth 180

actor "Learner" as Learner #FFF2CC
participant "Web UI\n(Frontend)" as UI #E6F7FF
participant "Backend API" as Server #FFE6E6
participant "Rewards Service" as Rewards #E6FFE6
database "Learner DB" as DB #E6FFE6
participant "Inventory Service" as Inventory #F0E6FF
participant "Payment Gateway" as Payment #F7F0D3
participant "Notification Service" as Notify #F2F2F2

== Browse reward catalog ==
Learner -> UI : openRewards()
activate UI
UI -> Server : GET /rewards/catalog
activate Server
Server -> Rewards : fetchCatalog()
activate Rewards
Rewards -> DB : SELECT * FROM rewards
activate DB
DB --> Rewards : itemsList
deactivate DB
Rewards --> Server : catalogItems
deactivate Rewards
Server --> UI : 200 OK {catalogItems}
deactivate Server
UI --> Learner : displayCatalog()
deactivate UI

== Redeem reward ==
Learner -> UI : redeemReward(itemId)
activate UI
UI -> Server : POST /rewards/redeem {learnerId, itemId}
activate Server

Server -> Rewards : getRewardDetails(itemId)
activate Rewards
Rewards --> Server : {costPoints, costCurrency, stock}
deactivate Rewards

Server -> DB : SELECT xp, currency WHERE learnerId
activate DB
DB --> Server : learnerData
deactivate DB

alt sufficient XP
  Server -> DB : UPDATE learners SET xp = xp - costPoints
  activate DB
  DB --> Server : updateAck
  deactivate DB

  Server -> Inventory : grantItem(learnerId, itemId)
  activate Inventory
  Inventory --> Server : grantAck
  deactivate Inventory

  Server -> Notify : sendRedeemConfirmation(learnerId, itemId, method:points)
  activate Notify
  Notify --> Server : notifyAck
  deactivate Notify

  Server --> UI : 200 OK {redeemed:true, method:points}

else insufficient XP → pay with currency
  Server -> Payment : charge(learnerId, costCurrency)
  activate Payment
  Payment --> Server : chargeResult(success)
  deactivate Payment

  alt chargeSuccess
    Server -> Inventory : grantItem(learnerId, itemId)
    activate Inventory
    Inventory --> Server : grantAck
    deactivate Inventory

    Server -> DB : recordPurchase(learnerId, itemId)
    activate DB
    DB --> Server : recordAck
    deactivate DB

    Server -> Notify : sendRedeemConfirmation(learnerId, itemId, method:currency)
    activate Notify
    Notify --> Server : notifyAck
    deactivate Notify

    Server --> UI : 200 OK {redeemed:true, method:currency}

  else chargeFailed
    Server --> UI : 402 Payment Required {redeemed:false, reason:payment_failed}
  end
end

deactivate Server
UI --> Learner : showRedeemResult()
deactivate UI

@enduml
