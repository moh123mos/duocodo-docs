@startuml
skinparam backgroundColor #FAFAFA
skinparam sequence {
  ArrowColor #2F5D8A
  LifeLineBorderColor #2F5D8A
  LifeLineBackgroundColor #D9E8F5
  ParticipantBorderColor #1B3C59
  ParticipantBackgroundColor #E6EEF5
  ActorBorderColor #3D3D3D
  ActorBackgroundColor #F2F2F2
  GroupBackgroundColor #F7F0D3
  GroupBorderColor #C5AF59
}
skinparam dpi 300
skinparam maxMessageSize 240
skinparam ParticipantPadding 30
skinparam sequenceParticipantWidth 180

actor "Learner" as Learner #FFF2CC
participant "Web UI\n(Frontend)" as WebUI #E6F7FF
participant "Backend API" as Backend #FFE6E6
participant "Social Service" as Social #E6FFE6
participant "Share Generator" as ShareGen #F0E6FF
database "Progress DB" as PDB #E6FFE6
participant "Notification Service" as Notify #F7F0D3
participant "Analytics Service" as Analytics #F2F2F2
participant "External Social Platforms\n(FB/Twitter/LinkedIn)" as External #F0E6FF

Learner -> WebUI : clickShareProgress(scope, message, platform?)
activate WebUI
WebUI -> Backend : POST /share/progress {userId, scope, message, platform}
activate Backend
Backend -> PDB : SELECT summary {completedCourses, xp, streak, badges} WHERE userId
activate PDB
PDB --> Backend : summaryData
deactivate PDB
Backend -> Analytics : generateShareSnapshot(userId, summaryData)
activate Analytics
Analytics --> Backend : snapshot {imageMeta, stats, shortText}
deactivate Analytics
Backend -> ShareGen : createShareAsset(snapshot, message, scope)
activate ShareGen
ShareGen -> ShareGen : renderShareImage(snapshot, branding)
ShareGen --> Backend : {shareUrl, assetId, preview}
deactivate ShareGen

alt platform == internalFeed
  Backend -> Social : POST /social/feed {userId, assetId, message, scope}
  activate Social
  Social -> Social : persistFeedItem
  Social -> Social : fanoutToFollowers(scope)
  Social --> Backend : feedAck {feedItemId}
  deactivate Social

  Backend -> Notify : sendInAppShareNotification(followers, feedItemId)
  activate Notify
  Notify --> Backend : notifyAck
  deactivate Notify

  Backend --> WebUI : 201 Created {shareType:internal, feedItemId, preview}
else platform == external
  Backend -> External : POST /post {platform, accessToken, message, shareUrl}
  activate External
  External --> Backend : postResult {success, externalId}
  deactivate External

  alt postSuccess
    Backend -> Social : recordExternalShare(userId, externalId, platform, assetId)
    activate Social
    Social --> Backend : recordAck
    deactivate Social
    Backend -> Notify : sendShareConfirmation(userId, platform, externalId)
    activate Notify
    Notify --> Backend : notifyAck
    deactivate Notify
    Backend --> WebUI : 201 Created {shareType:external, externalId, preview}
  else postFailed
    Backend --> WebUI : 502 Bad Gateway {error:external_share_failed}
  end
end

deactivate Backend
WebUI --> Learner : showShareResult(preview, status)
deactivate WebUI

opt viewSharedItem
  Learner -> WebUI : openSharedItem(itemId)
  activate WebUI
  WebUI -> Backend : GET /share/{itemId}
  activate Backend
  Backend -> Social : fetchShareItem(itemId)
  activate Social
  Social -> PDB : fetchRelatedProgress(userId)
  activate PDB
  PDB --> Social : relatedData
  deactivate PDB
  Social --> Backend : shareItemPayload
  deactivate Social
  Backend --> WebUI : 200 OK {shareItemPayload}
  deactivate Backend
  WebUI --> Learner : displaySharedItem()
  deactivate WebUI
end

@enduml
