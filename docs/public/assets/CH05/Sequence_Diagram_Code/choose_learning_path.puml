@startuml Choose_Learning_Path
skinparam backgroundColor #FAFAFA
skinparam sequence {
  ArrowColor #2F5D8A
  LifeLineBorderColor #2F5D8A
  LifeLineBackgroundColor #D9E8F5
  ParticipantBorderColor #1B3C59
  ParticipantBackgroundColor #E6EEF5
  ActorBorderColor #3D3D3D
  ActorBackgroundColor #F2F2F2
  GroupBackgroundColor #F7F0D3
  GroupBorderColor #C5AF59
}
skinparam dpi 300
skinparam maxMessageSize 240
skinparam ParticipantPadding 30
skinparam sequenceParticipantWidth 180

actor "Learner" as Learner #FFF2CC
participant "Web UI\n(Frontend)" as WebUI #E6F7FF
participant "Path Service" as PathSvc #F0E6FF
participant "Backend API" as Backend #FFE6E6
database "Database" as DB #E6FFE6

Learner -> WebUI : Open 'Choose Learning Path' page
activate WebUI

WebUI -> Backend : GET /paths/available?userId={userId}
activate Backend
Backend -> DB : Query recommended paths {userProfile, progress}
activate DB
DB --> Backend : pathsList {pathId, title, difficulty, completionRate}
deactivate DB
Backend --> WebUI : 200 OK {pathsList}
deactivate Backend

WebUI --> Learner : Show available paths (recommendations)

Learner -> WebUI : Filter / search paths {topic, level}
activate WebUI
WebUI -> Backend : GET /paths?filter={...}
activate Backend
Backend -> DB : Query paths {filter}
activate DB
DB --> Backend : filteredPaths
deactivate DB
Backend --> WebUI : 200 OK {filteredPaths}
deactivate Backend
WebUI --> Learner : Display filtered results
deactivate WebUI

opt Preview path details
  Learner -> WebUI : Click path -> View details {pathId}
  activate WebUI
  WebUI -> Backend : GET /paths/{pathId}
  activate Backend
  Backend -> DB : Fetch path modules, prerequisites, estimatedTime
  activate DB
  DB --> Backend : pathDetails
  deactivate DB
  Backend --> WebUI : 200 OK {pathDetails}
  deactivate Backend
  WebUI --> Learner : Show path details (modules, timeline, badges)
  deactivate WebUI
end

opt Enroll in path
  Learner -> WebUI : Click "Enroll" {pathId}
  activate WebUI
  WebUI -> Backend : POST /paths/{pathId}/enroll {userId}
  activate Backend
  Backend -> DB : Create enrollment record {userId, pathId, startDate}
  activate DB
  DB --> Backend : enrollmentId
  deactivate DB
  Backend --> WebUI : 201 Created {enrollmentId}
  deactivate Backend
  WebUI --> Learner : Show enrollment confirmation & next steps
  deactivate WebUI
end

opt Personalized recommendation refresh
  WebUI -> Backend : POST /recommendations/refresh {userId}
  activate Backend
  Backend -> PathSvc : Recalculate recommendations {userProfile, activity}
  activate PathSvc
  PathSvc --> Backend : updatedRecommendations
  deactivate PathSvc
  Backend --> WebUI : 200 OK {updatedRecommendations}
  deactivate Backend
  WebUI --> Learner : Update recommendations in UI
end

@enduml
