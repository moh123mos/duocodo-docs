@startuml
skinparam backgroundColor #FAFAFA
skinparam sequence {
  ArrowColor #2F5D8A
  LifeLineBorderColor #2F5D8A
  LifeLineBackgroundColor #D9E8F5
  ParticipantBorderColor #1B3C59
  ParticipantBackgroundColor #E6EEF5
  ActorBorderColor #3D3D3D
  ActorBackgroundColor #F2F2F2
  GroupBackgroundColor #F7F0D3
  GroupBorderColor #C5AF59
}
skinparam dpi 300
skinparam maxMessageSize 240
skinparam ParticipantPadding 30
skinparam sequenceParticipantWidth 180

actor "Learner" as Learner #FFF2CC
participant "Web UI\n(Frontend)" as WebUI #E6F7FF
participant "Backend API" as Backend #FFE6E6
participant "Leaderboard Service" as LB #E6FFE6
database "Progress DB" as PDB #E6FFE6
database "Cache (Redis)" as Cache #F0E6FF
participant "Analytics Service" as Analytics #F2F2F2

Learner -> WebUI : openLeaderboard(page, filter)
activate WebUI
WebUI -> Backend : GET /leaderboard?page=&filter=
activate Backend

Backend -> Cache : GET leaderboard:{filter}:page:{page}
activate Cache
Cache --> Backend : cachedResult or miss
deactivate Cache

alt cacheHit
  Backend --> WebUI : 200 OK {cachedResult}
else cacheMiss
  Backend -> LB : fetchLeaderboard(page, filter)
  activate LB
  LB -> PDB : queryTopUsers(filter, offset, limit)
  activate PDB
  PDB --> LB : rows {userId, xp, rank}
  deactivate PDB
  LB -> Analytics : enrichWithTrends(rows)
  activate Analytics
  Analytics --> LB : enrichedRows
  deactivate Analytics
  LB -> Cache : SET leaderboard:{filter}:page:{page} (enrichedRows) EX 300
  activate Cache
  Cache --> LB : setAck
  deactivate Cache
  LB --> Backend : 200 OK {enrichedRows, pageInfo}
  deactivate LB
  Backend --> WebUI : 200 OK {enrichedRows, pageInfo}
end

deactivate Backend
WebUI --> Learner : displayLeaderboard(list, pagination, filters)
deactivate WebUI

opt viewUserProfileFromLeaderboard
  Learner -> WebUI : clickUser(userId)
  activate WebUI
  WebUI -> Backend : GET /users/{userId}/summary
  activate Backend
  Backend -> PDB : SELECT summary WHERE id = userId
  activate PDB
  PDB --> Backend : userSummary
  deactivate PDB
  Backend --> WebUI : 200 OK {userSummary}
  deactivate Backend
  WebUI --> Learner : showUserProfileModal()
  deactivate WebUI
end

@enduml
