@startuml Track_Progress
skinparam backgroundColor #FAFAFA
skinparam sequence {
  ArrowColor #2F5D8A
  LifeLineBorderColor #2F5D8A
  LifeLineBackgroundColor #D9E8F5
  ParticipantBorderColor #1B3C59
  ParticipantBackgroundColor #E6EEF5
  ActorBorderColor #3D3D3D
  ActorBackgroundColor #F2F2F2
  GroupBackgroundColor #F7F0D3
  GroupBorderColor #C5AF59
}
skinparam dpi 300
skinparam maxMessageSize 240
skinparam ParticipantPadding 30
skinparam sequenceParticipantWidth 180

actor "Learner" as Learner #FFF2CC
participant "Web UI\n(Frontend)" as WebUI #E6F7FF
participant "Backend API" as Backend #FFE6E6
database "Progress DB" as PDB #E6FFE6
participant "Analytics Service" as Analytics #F0E6FF

Learner -> WebUI : Open Progress Dashboard
activate WebUI

WebUI -> Backend : GET /users/{id}/progress
activate Backend

Backend -> PDB : Fetch progress records {completedLessons, completedExercises, XP, streaks}
activate PDB
PDB --> Backend : progressData
deactivate PDB

Backend -> Analytics : Calculate trends, graphs, predictions
activate Analytics
Analytics --> Backend : analyticsData {charts, streakHealth, levelProgress}
deactivate Analytics

Backend --> WebUI : 200 OK {progressData, analyticsData}
deactivate Backend

WebUI --> Learner : Display progress dashboard
WebUI --> Learner : Show lessons, exercises, streaks, graphs
deactivate WebUI

opt View detailed module progress
  Learner -> WebUI : Open module details {moduleId}
  activate WebUI

  WebUI -> Backend : GET /modules/{moduleId}/progress
  activate Backend
  Backend -> PDB : Fetch module-level progress
  activate PDB
  PDB --> Backend : moduleProgress
  deactivate PDB
  Backend --> WebUI : 200 OK {moduleProgress}
  deactivate Backend

  WebUI --> Learner : Show detailed module progress (topics, locked/unlocked, percent)
  deactivate WebUI
end

opt Regenerate analytics
  Learner -> WebUI : Click "Refresh Analytics"
  activate WebUI
  WebUI -> Backend : POST /analytics/refresh {userId}
  activate Backend
  Backend -> Analytics : Re-run analytics pipeline
  activate Analytics
  Analytics --> Backend : newAnalytics
  deactivate Analytics
  Backend --> WebUI : 200 OK {newAnalytics}
  deactivate Backend
  WebUI --> Learner : Update charts
  deactivate WebUI
end

@enduml
