@startuml
skinparam backgroundColor #FAFAFA
skinparam sequence {
  ArrowColor #2F5D8A
  LifeLineBorderColor #2F5D8A
  LifeLineBackgroundColor #D9E8F5
  ParticipantBorderColor #1B3C59
  ParticipantBackgroundColor #E6EEF5
  ActorBorderColor #3D3D3D
  ActorBackgroundColor #F2F2F2
  GroupBackgroundColor #F7F0D3
  GroupBorderColor #C5AF59
}
skinparam dpi 300
skinparam maxMessageSize 240
skinparam ParticipantPadding 30
skinparam sequenceParticipantWidth 180

actor "Learner" as Learner #FFF2CC
participant "Web UI\n(Frontend)" as WebUI #E6F7FF
participant "Backend API" as Backend #FFE6E6
participant "Course Service" as CourseSvc #E6FFE6
database "Enrollment DB" as EDB #E6FFE6
participant "Payment Gateway" as Payment #F0E6FF
participant "Notification Service" as Notify #F2F2F2

Learner -> WebUI : openCoursePage(courseId)
activate WebUI
WebUI -> Backend : GET /courses/{courseId}
activate Backend
Backend -> CourseSvc : fetchCourseDetails(courseId)
activate CourseSvc
CourseSvc -> EDB : checkEnrollmentStatus(userId, courseId)
activate EDB
EDB --> CourseSvc : enrollmentRecord or null
deactivate EDB
CourseSvc --> Backend : courseDetails {price, seats, prerequisites, enrolled}
deactivate CourseSvc
Backend --> WebUI : 200 OK {courseDetails}
deactivate Backend
WebUI --> Learner : displayCoursePage(details)
deactivate WebUI

Learner -> WebUI : clickEnroll()
activate WebUI
WebUI -> Backend : POST /courses/{courseId}/enroll {userId, method}
activate Backend
Backend -> CourseSvc : validateEnrollment(userId, courseId)
activate CourseSvc
CourseSvc -> EDB : readPrerequisites(userId, courseId)
activate EDB
EDB --> CourseSvc : prerequisitesStatus
deactivate EDB

alt eligibleFreeOrIncluded
  CourseSvc -> EDB : createEnrollment(userId, courseId, status:active)
  activate EDB
  EDB --> CourseSvc : enrollmentAck
  deactivate EDB
  CourseSvc --> Backend : enrollResult {status:enrolled, method:free}
  deactivate CourseSvc

  Backend -> Notify : sendEnrollmentConfirmation(userId, courseId)
  activate Notify
  Notify --> Backend : notifyAck
  deactivate Notify

  Backend --> WebUI : 200 OK {enrolled:true, method:free}
else paidCourse
  Backend -> Payment : createCharge(userId, amount=coursePrice, method)
  activate Payment
  Payment --> Backend : chargeResult {success, transactionId}
  deactivate Payment

  alt paymentSuccess
    CourseSvc -> EDB : createEnrollment(userId, courseId, status:active, tx:transactionId)
    activate EDB
    EDB --> CourseSvc : enrollmentAck
    deactivate EDB
    CourseSvc --> Backend : enrollResult {status:enrolled, method:paid, transactionId}
    deactivate CourseSvc

    Backend -> Notify : sendEnrollmentConfirmation(userId, courseId, transactionId)
    activate Notify
    Notify --> Backend : notifyAck
    deactivate Notify

    Backend --> WebUI : 200 OK {enrolled:true, method:paid, transactionId}
  else paymentFailed
    Backend --> WebUI : 402 Payment Required {enrolled:false, reason:payment_failed}
  end
end

deactivate Backend
WebUI --> Learner : showEnrollmentResu
