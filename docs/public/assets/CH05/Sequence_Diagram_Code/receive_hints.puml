@startuml Receive_AI_Hints
skinparam backgroundColor #FAFAFA

skinparam sequence {
  ArrowColor #2F5D8A
  LifeLineBorderColor #2F5D8A
  LifeLineBackgroundColor #D9E8F5
  ParticipantBorderColor #1B3C59
  ParticipantBackgroundColor #E6EEF5
  ActorBorderColor #3D3D3D
  ActorBackgroundColor #F2F2F2
  GroupBackgroundColor #F7F0D3
  GroupBorderColor #C5AF59
}

actor "Learner" as Learner #FFF2CC
participant "Web UI" as WebUI #E6F7FF
participant "Hints Service\n(AI)" as Hints #F0E6FF
participant "Backend API" as Backend #FFE6E6

Learner -> WebUI : Request hint (exerciseId, codeContext, cursor)
activate WebUI

WebUI -> Backend : POST /hints {exerciseId, codeContext, cursor, userId}
activate Backend

Backend -> Hints : Query AI {context, difficulty, profile}
activate Hints

Hints --> Backend : hintPayload {text, suggestions, confidence}
deactivate Hints

Backend --> WebUI : 200 OK {hintPayload}
deactivate Backend

WebUI --> Learner : Show hint (inline suggestion)
deactivate WebUI

alt Low confidence (confidence < threshold)
  WebUI -> Backend : POST /hints/expand {hintId, requestDetails}
  activate Backend

  Backend -> Hints : Expand explanation {hintId, examples}
  activate Hints
  Hints --> Backend : expandedHint {text, steps, examples}
  deactivate Hints

  Backend --> WebUI : 200 OK {expandedHint}
  deactivate Backend

  WebUI --> Learner : Show expanded hint
end

opt Save hint interaction
  WebUI -> Backend : POST /hints/{hintId}/interaction {userId, accepted, timestamp}
  activate Backend
  Backend --> WebUI : 201 Created
  deactivate Backend
end

@enduml
