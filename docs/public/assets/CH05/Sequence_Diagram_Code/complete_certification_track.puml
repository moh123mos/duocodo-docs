@startuml Complete_Certification_Track
skinparam backgroundColor #FAFAFA
skinparam sequence {
  ArrowColor #2F5D8A
  LifeLineBorderColor #2F5D8A
  LifeLineBackgroundColor #D9E8F5
  ParticipantBorderColor #1B3C59
  ParticipantBackgroundColor #E6EEF5
  ActorBorderColor #3D3D3D
  ActorBackgroundColor #F2F2F2
  GroupBackgroundColor #F7F0D3
  GroupBorderColor #C5AF59
}

actor "Learner" as Learner #FFF2CC
participant "Web UI\n(Frontend)" as WebUI #E6F7FF
participant "Certification\nService" as CertSvc #F0E6FF
participant "Backend API" as Backend #FFE6E6
database "Database" as DB #E6FFE6

Learner -> WebUI : Start certification track {trackId}
activate WebUI
WebUI -> Backend : GET /certifications/{trackId}
activate Backend
Backend --> WebUI : 200 OK {modules, requirements, deadlines}
deactivate Backend
deactivate WebUI

loop For each module in track
  Learner -> WebUI : Open module / take assessment {moduleId}
  activate WebUI
  WebUI -> Backend : POST /certifications/{trackId}/modules/{moduleId}/submit {answers}
  activate Backend
  Backend -> CertSvc : Evaluate module {answers, moduleId}
  activate CertSvc
  CertSvc --> Backend : result {pass/fail, score, feedback}
  deactivate CertSvc
  Backend -> DB : Store module result {userId, moduleId, score}
  activate DB
  DB --> Backend : OK
  deactivate DB
  Backend --> WebUI : 200 OK {moduleResult}
  deactivate Backend
  WebUI --> Learner : Show module result (pass/fail, score, feedback)
  deactivate WebUI

  alt Module failed and retry allowed
    Learner -> WebUI : Retry module / resubmit
    activate WebUI
    WebUI -> Backend : POST /certifications/{trackId}/modules/{moduleId}/resubmit {answers}
    activate Backend
    Backend -> CertSvc : Re-evaluate module
    activate CertSvc
    CertSvc --> Backend : result {pass/fail, score}
    deactivate CertSvc
    Backend -> DB : Update module result
    activate DB
    DB --> Backend : OK
    deactivate DB
    Backend --> WebUI : 200 OK {moduleResult}
    deactivate Backend
    WebUI --> Learner : Show updated result
    deactivate WebUI
  end
end

Learner -> WebUI : Request certification completion
activate WebUI
WebUI -> Backend : POST /certifications/{trackId}/complete
activate Backend
Backend -> CertSvc : Verify completion & issue certificate
activate CertSvc
CertSvc --> Backend : certificate {id, url, issuedAt}
deactivate CertSvc
Backend -> DB : Save certificate record {userId, certId, meta}
activate DB
DB --> Backend : OK
deactivate DB
Backend --> WebUI : 200 OK {certificate}
deactivate Backend
WebUI --> Learner : Provide certificate & badge {certUrl, badge}
deactivate WebUI

@enduml
