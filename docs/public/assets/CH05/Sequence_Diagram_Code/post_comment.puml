@startuml
skinparam backgroundColor #FAFAFA
skinparam sequence {
  ArrowColor #2F5D8A
  LifeLineBorderColor #2F5D8A
  LifeLineBackgroundColor #D9E8F5
  ParticipantBorderColor #1B3C59
  ParticipantBackgroundColor #E6EEF5
  ActorBorderColor #3D3D3D
  ActorBackgroundColor #F2F2F2
  GroupBackgroundColor #F7F0D3
  GroupBorderColor #C5AF59
}
skinparam dpi 300
skinparam maxMessageSize 240
skinparam ParticipantPadding 30
skinparam sequenceParticipantWidth 180

actor "User" as User #FFF2CC
participant "Web UI\n(Frontend)" as WebUI #E6F7FF
participant "Backend API" as Backend #FFE6E6
participant "Forum Service" as Forum #E6FFE6
database "Forum DB" as FDB #E6FFE6
participant "Moderation Service" as Mod #F0E6FF
participant "Notification Service" as Notify #F2F2F2

User -> WebUI : openThread(threadId)
activate WebUI
WebUI -> Backend : GET /threads/{threadId}
activate Backend
Backend -> Forum : fetchThread(threadId, page)
activate Forum
Forum -> FDB : SELECT thread, comments WHERE id=threadId LIMIT...
activate FDB
FDB --> Forum : threadData
deactivate FDB
Forum --> Backend : threadData
deactivate Forum
Backend --> WebUI : 200 OK {threadData}
deactivate Backend
WebUI --> User : displayThread(threadData)
deactivate WebUI

== User posts a comment ==
User -> WebUI : submitComment(threadId, parentId?, content)
activate WebUI
WebUI -> Backend : POST /threads/{threadId}/comments {userId, content, parentId}
activate Backend
Backend -> Forum : validateAndCreateComment(userId, threadId, parentId, content)
activate Forum
Forum -> Mod : runAutoModeration(content)
activate Mod
Mod --> Forum : moderationResult {ok|flagged, reason}
deactivate Mod

alt moderationOk
  Forum -> FDB : INSERT comment (threadId, userId, content, status:published)
  activate FDB
  FDB --> Forum : insertAck {commentId, createdAt}
  deactivate FDB
  Forum --> Backend : 201 Created {commentId, createdAt, status:published}
  deactivate Forum

  Backend -> Notify : sendCommentNotifications(threadId, commentId)
  activate Notify
  Notify --> Backend : notifyAck
  deactivate Notify

  Backend --> WebUI : 201 Created {commentId, createdAt, status:published}
else flaggedForReview
  Forum -> FDB : INSERT comment (threadId, userId, content, status:pending)
  activate FDB
  FDB --> Forum : insertAck {commentId, createdAt}
  deactivate FDB
  Forum --> Backend : 202 Accepted {commentId, createdAt, status:pending, reason}
  deactivate Forum

  Backend -> Mod : enqueueForManualReview(commentId)
  activate Mod
  Mod --> Backend : enqueueAck
  deactivate Mod

  Backend --> WebUI : 202 Accepted {commentId, createdAt, status:pending}
end

deactivate Backend
WebUI --> User : showCommentStatus()
deactivate WebUI

opt Moderator reviews flagged comment
  Mod -> Forum : fetchComment(commentId)
  activate Forum
  Forum -> FDB : SELECT comment WHERE id=commentId
  activate FDB
  FDB --> Forum : commentRecord
  deactivate FDB
  Forum --> Mod : commentRecord
  deactivate Forum

  Mod -> Mod : decide {approve|reject|edit}
  alt approve
    Mod -> Forum : updateCommentStatus(commentId, published)
    activate Forum
    Forum -> FDB : UPDATE comments SET status=published WHERE id=commentId
    activate FDB
    FDB --> Forum : updateAck
    deactivate FDB
    Forum --> Mod : updated
    deactivate Forum

    Mod -> Backend : notifyApproval(commentId)
    activate Backend
    Backend -> Notify : sendCommentNotifications(threadId, commentId)
    activate Notify
    Notify --> Backend : notifyAck
    deactivate Notify
    Backend --> Mod : ack
    deactivate Backend
  else reject
    Mod -> Forum : updateCommentStatus(commentId, rejected)
    activate Forum
    Forum -> FDB : UPDATE comments SET status=rejected WHERE id=commentId
    activate FDB
    FDB --> Forum : updateAck
    deactivate FDB
    Forum --> Mod : updated
    deactivate Forum

    Mod -> Backend : notifyRejection(commentId, reason)
    activate Backend
    Backend --> Mod : ack
    deactivate Backend
  end
end

@enduml
