@startuml
skinparam backgroundColor #FAFAFA
skinparam sequence {
  ArrowColor #2F5D8A
  LifeLineBorderColor #2F5D8A
  LifeLineBackgroundColor #D9E8F5
  ParticipantBorderColor #1B3C59
  ParticipantBackgroundColor #E6EEF5
  ActorBorderColor #3D3D3D
  ActorBackgroundColor #F2F2F2
  GroupBackgroundColor #F7F0D3
  GroupBorderColor #C5AF59
}
skinparam dpi 300
skinparam maxMessageSize 240
skinparam ParticipantPadding 30
skinparam sequenceParticipantWidth 180

actor "Learner" as Learner #FFF2CC
participant "Web UI\n(Frontend)" as WebUI #E6F7FF
participant "Search API" as Search #FFE6E6
participant "Catalog Service" as Catalog #E6FFE6
database "Courses DB" as CDB #E6FFE6
participant "Recommendation Service" as Rec #F0E6FF
participant "Cache (Redis)" as Cache #F7F0D3

Learner -> WebUI : openCatalog()
activate WebUI
WebUI -> Cache : GET catalog:homepage
activate Cache
Cache --> WebUI : cachedHomepage or miss
deactivate Cache

alt cacheHit
  WebUI --> Learner : displayCatalog(cachedHomepage)
else cacheMiss
  WebUI -> Catalog : GET /catalog/home
  activate Catalog
  Catalog -> CDB : SELECT featured, categories, topCourses
  activate CDB
  CDB --> Catalog : catalogData
  deactivate CDB
  Catalog -> Rec : enrichWithRecommendations(userId)
  activate Rec
  Rec --> Catalog : recommendations
  deactivate Rec
  Catalog -> Cache : SET catalog:homepage (catalogData+recommendations) EX 300
  activate Cache
  Cache --> Catalog : setAck
  deactivate Cache
  Catalog --> WebUI : 200 OK {catalogData, recommendations}
  deactivate Catalog
  WebUI --> Learner : displayCatalog(catalogData, recommendations)
end
deactivate WebUI

== Search flow ==
Learner -> WebUI : search(query, filters, sort, page)
activate WebUI
WebUI -> Search : GET /search?q=query&filters...
activate Search
Search -> Cache : GET search:hash(query+filters+page)
activate Cache
Cache --> Search : cachedResults or miss
deactivate Cache

alt cacheHit
  Search --> WebUI : 200 OK {cachedResults}
else cacheMiss
  Search -> Catalog : queryIndex(query, filters, page, sort)
  activate Catalog
  Catalog -> CDB : searchQuery(...)
  activate CDB
  CDB --> Catalog : rows {courseId, title, snippet, score}
  deactivate CDB
  Catalog -> Rec : applyPersonalization(userId, rows)
  activate Rec
  Rec --> Catalog : personalizedRows
  deactivate Rec
  Catalog -> Cache : SET search:hash(...) (personalizedRows) EX 120
  activate Cache
  Cache --> Catalog : setAck
  deactivate Cache
  Catalog --> Search : 200 OK {personalizedRows, pageInfo}
  deactivate Catalog
  Search --> WebUI : 200 OK {results, pageInfo}
end
deactivate Search
WebUI --> Learner : showSearchResults(results, pagination)

opt viewCourseDetails
  Learner -> WebUI : openCourse(courseId)
  activate WebUI
  WebUI -> Catalog : GET /courses/{courseId}
  activate Catalog
  Catalog -> CDB : SELECT * FROM courses WHERE id=courseId
  activate CDB
  CDB --> Catalog : courseDetail
  deactivate CDB
  Catalog -> Rec : fetchSimilarCourses(courseId)
  activate Rec
  Rec --> Catalog : similarCourses
  deactivate Rec
  Catalog --> WebUI : 200 OK {courseDetail, similarCourses}
  deactivate Catalog
  WebUI --> Learner : displayCoursePage(courseDetail, similar)
  deactivate WebUI
end

@enduml
