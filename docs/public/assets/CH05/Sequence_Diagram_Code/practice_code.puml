@startuml PracticeCoding_Monaco_Colored_Clean

' ============================
' GLOBAL THEME / COLORS
' ============================
skinparam backgroundColor #FAFAFA
skinparam sequence {
  ArrowColor #2F5D8A
  LifeLineBorderColor #2F5D8A
  LifeLineBackgroundColor #D9E8F5
  ParticipantBorderColor #1B3C59
  ParticipantBackgroundColor #E6EEF5
  ActorBorderColor #3D3D3D
  ActorBackgroundColor #F2F2F2
  GroupBackgroundColor #F7F0D3
  GroupBorderColor #C5AF59
}

title **Practice Coding with Monaco Editor**

' ============================
' PARTICIPANTS
' ============================
actor "Learner" as Learner #FFF2CC
participant "Web UI\n(Frontend)" as WebUI #E6F7FF
participant "Monaco\nEditor" as Monaco #F0E6FF
participant "Backend API" as Backend #FFE6E6
participant "Code Runner\nService" as Runner #FFF0CC
database "Database" as DB #E6FFE6

' ============================
' MAIN FLOW WITH ALTERNATIVE
' ============================

Learner -> WebUI : Open exercise
activate WebUI

WebUI -> Backend : GET /exercises/{id}
activate Backend

group Load Exercise
  alt Exercise Found
    Backend --> WebUI : 200 OK (problem, tests)
    deactivate Backend

    WebUI -> Monaco : Load problem
    activate Monaco
    Monaco --> WebUI : ready
    deactivate Monaco
    deactivate WebUI

  else Exercise Not Found
    Backend --> WebUI : 404 Not Found / 500 Error
    deactivate Backend

    WebUI --> Learner : Show error message\n("Exercise unavailable")
    deactivate WebUI

    ' Diagram ends here for this path
    return
  end
end group

' ============================
' RUN CODE FLOW
' ============================
Learner -> WebUI : Click **Run**
activate WebUI
WebUI -> Backend : POST /run {code}
activate Backend
Backend -> Runner : Execute in sandbox
activate Runner

group Run Execution
  alt Compile / Runtime Error
    Runner --> Backend : error(stderr)
    Backend --> WebUI : error response
    WebUI -> Monaco : show stderr
  else Successful Execution
    Runner --> Backend : results(stdout, testsPassed)
    Backend --> WebUI : execution result
    WebUI -> Monaco : display results
  end
end gro+up

deactivate Runner
deactivate Backend
deactivate WebUI

' ============================
' SUBMISSION FLOW
' ============================
Learner -> WebUI : Click **Submit**
activate WebUI
WebUI -> Backend : POST /submissions
activate Backend

Backend -> Runner : Full evaluation
activate Runner
Runner --> Backend : evaluation result
deactivate Runner

Backend -> DB : Store submission
activate DB
DB --> Backend : OK
deactivate DB

Backend -> DB : Update XP + Progress
activate DB
DB --> Backend : OK
deactivate DB

Backend --> WebUI : 200 OK {score, XP}
deactivate Backend

WebUI --> Learner : Show score + XP gained
deactivate WebUI

@enduml
