@startuml
skinparam backgroundColor #FAFAFA
skinparam sequence {
  ArrowColor #2F5D8A
  LifeLineBorderColor #2F5D8A
  LifeLineBackgroundColor #D9E8F5
  ParticipantBorderColor #1B3C59
  ParticipantBackgroundColor #E6EEF5
  ActorBorderColor #3D3D3D
  ActorBackgroundColor #F2F2F2
  GroupBackgroundColor #F7F0D3
  GroupBorderColor #C5AF59
}
skinparam dpi 300
skinparam maxMessageSize 240
skinparam ParticipantPadding 30
skinparam sequenceParticipantWidth 180

actor "Learner" as Learner #FFF2CC
participant "Web UI\n(Frontend)" as WebUI #E6F7FF
participant "Backend API" as Backend #FFE6E6
participant "Resource Service" as ResourceSvc #E6FFE6
participant "Storage (CDN)" as Storage #F0E6FF
database "User DB" as UDB #E6FFE6
participant "Notification Service" as Notify #F7F0D3
participant "Cache (Redis)" as Cache #F2F2F2

Learner -> WebUI : openLessonResources(lessonId)
activate WebUI
WebUI -> Backend : GET /lessons/{lessonId}/resources
activate Backend
Backend -> Cache : GET lesson:{lessonId}:resources
activate Cache
Cache --> Backend : cachedResources or miss
deactivate Cache

alt cacheHit
  Backend --> WebUI : 200 OK {resources}
else cacheMiss
  Backend -> ResourceSvc : fetchResources(lessonId)
  activate ResourceSvc
  ResourceSvc -> Storage : listObjects(prefix=lessonId/)
  activate Storage
  Storage --> ResourceSvc : objectsList {id, name, size, url, access}
  deactivate Storage
  ResourceSvc -> Backend : resourcesList
  deactivate ResourceSvc
  Backend -> Cache : SET lesson:{lessonId}:resources (resourcesList) EX 300
  activate Cache
  Cache --> Backend : setAck
  deactivate Cache
  Backend --> WebUI : 200 OK {resourcesList}
end
deactivate Backend
WebUI --> Learner : displayResources(list)
deactivate WebUI

== Learner requests download ==
Learner -> WebUI : downloadResource(resourceId)
activate WebUI
WebUI -> Backend : POST /resources/{resourceId}/request-download {userId}
activate Backend
Backend -> UDB : SELECT permissions WHERE userId = {userId}
activate UDB
UDB --> Backend : permissionRecord
deactivate UDB

alt hasAccess
  Backend -> ResourceSvc : getResourceMetadata(resourceId)
  activate ResourceSvc
  ResourceSvc --> Backend : {url, requiresAuth, signedUrlTTL}
  deactivate ResourceSvc

  alt requiresAuth
    Backend -> Storage : generateSignedUrl(resourcePath, ttl=signedUrlTTL)
    activate Storage
    Storage --> Backend : signedUrl
    deactivate Storage
    Backend -> Backend : recordDownload(userId, resourceId, timestamp)
    Backend -> Notify : optionalDownloadReceipt(userId, resourceId)
    activate Notify
    Notify --> Backend : ack
    deactivate Notify
    Backend --> WebUI : 200 OK {downloadUrl:signedUrl}
  else publicResource
    Backend -> Backend : recordDownload(userId, resourceId, timestamp)
    Backend --> WebUI : 200 OK {downloadUrl:publicUrl}
  end

else noAccess
  Backend --> WebUI : 403 Forbidden {error:no_access}
end

deactivate Backend
WebUI --> Learner : redirectTo(downloadUrl) or showError()
deactivate WebUI

@enduml
