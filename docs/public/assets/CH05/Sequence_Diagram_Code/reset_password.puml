@startuml
skinparam backgroundColor #FAFAFA
skinparam sequence {
  ArrowColor #2F5D8A
  LifeLineBorderColor #2F5D8A
  LifeLineBackgroundColor #D9E8F5
  ParticipantBorderColor #1B3C59
  ParticipantBackgroundColor #E6EEF5
  ActorBorderColor #3D3D3D
  ActorBackgroundColor #F2F2F2
  GroupBackgroundColor #F7F0D3
  GroupBorderColor #C5AF59
}
skinparam dpi 300
skinparam maxMessageSize 240
skinparam ParticipantPadding 30
skinparam sequenceParticipantWidth 180

actor "User" as User #FFF2CC
participant "Web UI\n(Frontend)" as WebUI #E6F7FF
participant "Auth API" as Auth #FFE6E6
database "User DB" as UDB #E6FFE6
participant "Email Service" as Email #F0E6FF

User -> WebUI : clickForgotPassword()
activate WebUI
WebUI -> Auth : POST /auth/forgot-password {email}
activate Auth

Auth -> UDB : SELECT user WHERE email = {email}
activate UDB
UDB --> Auth : userRecord or null
deactivate UDB

alt emailExists
  Auth -> Auth : generateResetToken()
  Auth -> UDB : UPDATE users SET resetToken,... WHERE id=userId
  activate UDB
  UDB --> Auth : updateAck
  deactivate UDB
  Auth -> Email : sendResetLink(email, resetToken)
  activate Email
  Email --> Auth : emailSent
  deactivate Email
  Auth --> WebUI : 200 OK {message:email_sent}
else emailNotFound
  Auth --> WebUI : 200 OK {message:email_sent}  'Do not reveal existence
end

deactivate Auth
WebUI --> User : showEmailInstructions()
deactivate WebUI

== User opens reset link ==
User -> WebUI : openResetLink(token)
activate WebUI
WebUI -> Auth : GET /auth/validate-token {token}
activate Auth
Auth -> UDB : SELECT user WHERE resetToken = token
activate UDB
UDB --> Auth : userRecord or null
deactivate UDB

alt validToken
  Auth --> WebUI : 200 OK {valid:true}
else invalidToken
  Auth --> WebUI : 400 {valid:false}
end
deactivate Auth
WebUI --> User : showResetPasswordForm()
deactivate WebUI

== Submit new password ==
User -> WebUI : submitNewPassword(newPassword)
activate WebUI
WebUI -> Auth : POST /auth/reset-password {token,newPassword}
activate Auth
Auth -> UDB : UPDATE users SET passwordHash=..., resetToken=NULL WHERE resetToken=token
activate UDB
UDB --> Auth : updateAck
deactivate UDB
Auth --> WebUI : 200 OK {reset:success}
deactivate Auth
WebUI --> User : showSuccess("Password updated")
deactivate WebUI

@enduml
