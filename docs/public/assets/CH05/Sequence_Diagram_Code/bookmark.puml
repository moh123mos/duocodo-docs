@startuml
skinparam backgroundColor #FAFAFA
skinparam sequence {
  ArrowColor #2F5D8A
  LifeLineBorderColor #2F5D8A
  LifeLineBackgroundColor #D9E8F5
  ParticipantBorderColor #1B3C59
  ParticipantBackgroundColor #E6EEF5
  ActorBorderColor #3D3D3D
  ActorBackgroundColor #F2F2F2
  GroupBackgroundColor #F7F0D3
  GroupBorderColor #C5AF59
}
skinparam dpi 300
skinparam maxMessageSize 240
skinparam ParticipantPadding 30
skinparam sequenceParticipantWidth 180

actor "Learner" as Learner #FFF2CC
participant "Web UI\n(Frontend)" as WebUI #E6F7FF
participant "Backend API" as Backend #FFE6E6
participant "Bookmark Service" as Bookmark #E6FFE6
database "User DB" as UDB #E6FFE6
participant "Cache (Redis)" as Cache #F0E6FF
participant "Notification Service" as Notify #F2F2F2

Learner -> WebUI : clickBookmark(lessonId)
activate WebUI
WebUI -> Backend : POST /users/{id}/bookmarks {lessonId}
activate Backend
Backend -> Bookmark : createOrToggleBookmark(userId, lessonId)
activate Bookmark
Bookmark -> UDB : SELECT bookmark WHERE userId, lessonId
activate UDB
UDB --> Bookmark : existingRecord or null
deactivate UDB

alt notBookmarked
  Bookmark -> UDB : INSERT bookmark(userId, lessonId, createdAt)
  activate UDB
  UDB --> Bookmark : insertAck {bookmarkId}
  deactivate UDB

  Bookmark -> Cache : DEL user:{userId}:bookmarks  'invalidate cache'
  activate Cache
  Cache --> Bookmark : delAck
  deactivate Cache

  Bookmark --> Backend : 201 Created {bookmarked:true, bookmarkId}
  deactivate Bookmark

  Backend -> Notify : sendBookmarkAck(userId, lessonId)
  activate Notify
  Notify --> Backend : notifyAck
  deactivate Notify

  Backend --> WebUI : 201 Created {bookmarked:true}
else alreadyBookmarked
  Bookmark -> UDB : DELETE FROM bookmarks WHERE userId=... AND lessonId=...
  activate UDB
  UDB --> Bookmark : deleteAck
  deactivate UDB

  Bookmark -> Cache : DEL user:{userId}:bookmarks
  activate Cache
  Cache --> Bookmark : delAck
  deactivate Cache

  Bookmark --> Backend : 200 OK {bookmarked:false}
  deactivate Bookmark

  Backend --> WebUI : 200 OK {bookmarked:false}
end

deactivate Backend
WebUI --> Learner : updateBookmarkUI(state)
deactivate WebUI
@enduml
