@startuml Create_Interactive_Walkthrough
skinparam backgroundColor #FAFAFA
skinparam sequence {
  ArrowColor #2F5D8A
  LifeLineBorderColor #2F5D8A
  LifeLineBackgroundColor #D9E8F5
  ParticipantBorderColor #1B3C59
  ParticipantBackgroundColor #E6EEF5
  ActorBorderColor #3D3D3D
  ActorBackgroundColor #F2F2F2
  GroupBackgroundColor #F7F0D3
  GroupBorderColor #C5AF59
}

actor "Content Creator" as Creator #FFF2CC
participant "Walkthrough UI" as WUI #E6F7FF
participant "Backend API" as Backend #FFE6E6
participant "Interactive Engine" as Engine #F0E6FF
database "Content DB" as CDB #E6FFE6

Creator -> WUI : New walkthrough -> define steps, triggers, checks
activate WUI
WUI -> Backend : POST /walkthroughs {steps, triggers, metadata}
activate Backend

Backend -> Engine : Register interactive steps {walkthroughId, steps}
activate Engine
Engine --> Backend : registrationResult {ok, warnings}
deactivate Engine

Backend -> CDB : Save walkthrough {walkthroughId, data}
activate CDB
CDB --> Backend : {walkthroughId}
deactivate CDB

Backend --> WUI : 201 Created {walkthroughId}
deactivate Backend
WUI --> Creator : Show saved walkthrough
deactivate WUI

opt Upload assets
  Creator -> WUI : Upload asset (image/video)
  activate WUI
  WUI -> Backend : POST /walkthroughs/{id}/assets {file}
  activate Backend
  Backend -> CDB : Store asset metadata & fileRef
  activate CDB
  CDB --> Backend : OK
  deactivate CDB
  Backend --> WUI : 200 Asset uploaded
  deactivate Backend
  WUI --> Creator : Asset uploaded
  deactivate WUI
end

opt Preview interactive flow
  Creator -> WUI : Preview walkthrough
  activate WUI
  WUI -> Backend : GET /walkthroughs/{id}/preview
  activate Backend
  Backend -> Engine : Simulate steps {walkthroughId, sampleUser}
  activate Engine
  Engine --> Backend : simulationResult {stepOutputs, checks}
  deactivate Engine
  Backend --> WUI : previewData
  deactivate Backend
  WUI --> Creator : Show interactive preview
  deactivate WUI
end

@enduml
