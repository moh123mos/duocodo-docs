@startuml Register_Account
' Source: file:/mnt/data/4a81da6b-ae44-4ff1-85c0-36b7cb7733ad.pdf
skinparam backgroundColor #FAFAFA
skinparam sequence {
  ArrowColor #2F5D8A
  LifeLineBorderColor #2F5D8A
  LifeLineBackgroundColor #D9E8F5
  ParticipantBorderColor #1B3C59
  ParticipantBackgroundColor #E6EEF5
  ActorBorderColor #3D3D3D
  ActorBackgroundColor #F2F2F2
  GroupBackgroundColor #F7F0D3
  GroupBorderColor #C5AF59
}

actor "Learner" as Learner #FFF2CC
participant "Web UI" as WebUI #E6F7FF
participant "Backend API" as Backend #FFE6E6
participant "Auth Service" as Auth #FFF0CC
participant "Email Service" as Email #F0E6FF
database "Database" as DB #E6FFE6

Learner -> WebUI : Open registration form
activate WebUI

WebUI -> Backend : POST /users/register {email, password, profile}
activate Backend

alt Email already exists
  Backend --> WebUI : 409 Conflict {message: "Email in use"}
  deactivate Backend
  WebUI --> Learner : Show error "Email already registered"
  deactivate WebUI
  return
end

Backend -> Auth : Create user credentials (hash password)
activate Auth
Auth --> Backend : credentialsId
deactivate Auth

Backend -> DB : Create user record {userId, credentialsId, status:pending}
activate DB
DB --> Backend : OK {userId}
deactivate DB

Backend -> Email : Send verification email {userId, token}
activate Email
Email --> Backend : 202 Accepted
deactivate Email

Backend --> WebUI : 201 Created {userId, message: "Verify email"}
deactivate Backend

WebUI --> Learner : Show "Check your email to verify account"

' Email verification flow
Learner -> WebUI : Click verification link (token)
activate WebUI
WebUI -> Backend : POST /users/{userId}/verify-email {token}
activate Backend
Backend -> DB : Lookup token & user
activate DB
DB --> Backend : tokenValid / tokenExpired
deactivate DB

alt Token valid
  Backend -> DB : Update user status to active
  activate DB
  DB --> Backend : OK
  deactivate DB
  Backend --> WebUI : 200 OK {status: active}
  WebUI --> Learner : Show "Account verified"
else Token invalid/expired
  Backend --> WebUI : 400 Invalid/Expired token
  WebUI --> Learner : Show "Verification failed" with resend option
end

deactivate Backend
deactivate WebUI

opt Resend verification
  Learner -> WebUI : Click "Resend verification"
  activate WebUI
  WebUI -> Backend : POST /users/{userId}/resend-verification
  activate Backend
  Backend -> Email : Send verification email {userId, token}
  activate Email
  Email --> Backend : 202 Accepted
  deactivate Email
  Backend --> WebUI : 200 OK {message: "Email resent"}
  deactivate Backend
  WebUI --> Learner : Show "Verification email resent"
  deactivate WebUI
end

@enduml
