@startuml
skinparam backgroundColor #FAFAFA
skinparam sequence {
  ArrowColor #2F5D8A
  LifeLineBorderColor #2F5D8A
  LifeLineBackgroundColor #D9E8F5
  ParticipantBorderColor #1B3C59
  ParticipantBackgroundColor #E6EEF5
  ActorBorderColor #3D3D3D
  ActorBackgroundColor #F2F2F2
  GroupBackgroundColor #F7F0D3
  GroupBorderColor #C5AF59
}
skinparam dpi 300
skinparam maxMessageSize 240
skinparam ParticipantPadding 30
skinparam sequenceParticipantWidth 180

actor "Learner" as Learner #FFF2CC
participant "Web UI\n(Frontend)" as WebUI #E6F7FF
participant "Backend API" as Backend #FFE6E6
participant "Quiz Service" as QuizSvc #E6FFE6
database "Quiz DB" as QDB #E6FFE6
participant "Analytics Service" as Analytics #F0E6FF
participant "Reporting Service" as Report #F7F0D3
participant "Notification Service" as Notify #F2F2F2
participant "Cache (Redis)" as Cache #F0E6FF

Learner -> WebUI : openQuizResults(attemptId)
activate WebUI
WebUI -> Backend : GET /quizzes/{quizId}/attempts/{attemptId}/results
activate Backend

Backend -> Cache : GET quiz:results:{attemptId}
activate Cache
Cache --> Backend : cachedResult or miss
deactivate Cache

alt cacheHit
  Backend --> WebUI : 200 OK {cachedResult}
else cacheMiss
  Backend -> QuizSvc : fetchAttemptResults(attemptId)
  activate QuizSvc
  QuizSvc -> QDB : SELECT answers, autoGrades, manualGrades WHERE attemptId=...
  activate QDB
  QDB --> QuizSvc : attemptData {answers, grades, meta}
  deactivate QDB
  QuizSvc -> Backend : attemptResults {answers, grades, feedback}
  deactivate QuizSvc

  Backend -> Analytics : computePerformanceMetrics(attemptId)
  activate Analytics
  Analytics -> QDB : fetchHistoricalData(userId, quizId)
  activate QDB
  QDB --> Analytics : historicalData
  deactivate QDB
  Analytics -> Analytics : compute {scoreDistribution, timePerQuestion, weakTopics}
  Analytics --> Backend : analyticsPayload {charts, insights}
  deactivate Analytics

  Backend -> Cache : SET quiz:results:{attemptId} (attemptResults+analytics) EX 300
  activate Cache
  Cache --> Backend : setAck
  deactivate Cache

  Backend --> WebUI : 200 OK {attemptResults, analyticsPayload}
end

deactivate Backend
WebUI --> Learner : displayResults(score, breakdown, feedback, charts)
deactivate WebUI

opt Request detailed report (instructor/export)
  Learner -> WebUI : requestReport(attemptId, format=PDF/CSV)
  activate WebUI
  WebUI -> Backend : POST /reports/generate {attemptId, format}
  activate Backend
  Backend -> Report : generateReport(attemptId, format)
  activate Report
  Report -> QDB : fetchAttemptAndContext(attemptId)
  activate QDB
  QDB --> Report : detailedData
  deactivate QDB
  Report -> Analytics : embedMetrics(detailedData)
  activate Analytics
  Analytics --> Report : enrichedReportData
  deactivate Analytics
  Report -> Report : render(format)
  Report --> Backend : {reportUrl, reportId}
  deactivate Report
  Backend --> WebUI : 201 Created {reportUrl, reportId}
  deactivate Backend
  WebUI --> Learner : provideDownloadLink(reportUrl)
  deactivate WebUI
end

opt Notify user when manual grading completes
  QuizSvc -> Backend : gradingCompleted(attemptId, finalGrade)
  activate Backend
  Backend -> Cache : DEL quiz:results:{attemptId}
  activate Cache
  Cache --> Backend : delAck
  deactivate Cache
  Backend -> Notify : sendResultNotification(userId, attemptId, finalGrade)
  activate Notify
  Notify --> Backend : notifyAck
  deactivate Notify
  Backend --> WebUI : pushUpdate {attemptId, finalGrade}
  deactivate Backend
end

@enduml
